<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {# `seoTitle` overrides the <title> without changing the on-page heading #}
  {% set pageTitle = seoTitle or title %}
  <title>{% if pageTitle and page.url != "/" %}{{ pageTitle }} – {{ site.name }}{% else %}{{ site.name }} – {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_GB">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/images/8L2A8462108106-2.jpg">
  <meta name="twitter:card" content="summary_large_image">

  {% set business = {
    "@context": "https://schema.org",
    "@type": "AccountingService",
    "@id": site.url + "/#business",
    "name": site.name,
    "description": site.description,
    "url": site.url + "/",
    "logo": site.url + "/assets/images/cropped-favicon-192x192.png",
    "image": site.url + "/assets/images/8L2A8462108106-2.jpg",
    "telephone": site.phoneHref | replace("tel:", ""),
    "email": site.email,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": site.postalAddress.streetAddress,
      "addressLocality": site.postalAddress.addressLocality,
      "addressRegion": site.postalAddress.addressRegion,
      "postalCode": site.postalAddress.postalCode,
      "addressCountry": site.postalAddress.addressCountry
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "17:00"
    },
    "areaServed": "GB",
    "founder": { "@type": "Person", "name": site.founder },
    "sameAs": [site.social.instagram, site.social.facebook]
  } %}
  <script type="application/ld+json">{{ business | dump | safe }}</script>
  {% if page.url != "/" and title and not noindex %}
  {% set breadcrumbs = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/" },
      { "@type": "ListItem", "position": 2, "name": title, "item": site.url + page.url }
    ]
  } %}
  <script type="application/ld+json">{{ breadcrumbs | dump | safe }}</script>
  {% endif %}

  <link rel="icon" href="/assets/images/cropped-favicon-32x32.png" sizes="32x32">
  <link rel="icon" href="/assets/images/cropped-favicon-192x192.png" sizes="192x192">
  <link rel="apple-touch-icon" href="/assets/images/cropped-favicon-180x180.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Open+Sans:wght@300;400;600;700&display=swap">
  <link rel="stylesheet" href="/assets/css/main.css">
  <script src="/assets/js/site.js" defer></script>
</head>
<body class="flex min-h-screen flex-col">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:text-navy">Skip to content</a>

  {% include "partials/header.njk" %}

  <main id="main" class="flex-1">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
</body>
</html>
