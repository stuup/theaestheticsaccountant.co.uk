{
  "name": "theaestheticsaccountant",
  "version": "1.0.0",
  "description": "The Aesthetics Accountant website (Eleventy + Tailwind)",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:css": "tailwindcss -i src/assets/css/main.css -o _site/assets/css/main.css --watch",
    "dev:eleventy": "eleventy --serve",
    "build": "npm run build:eleventy && npm run build:css",
    "build:eleventy": "eleventy",
    "build:css": "tailwindcss -i src/assets/css/main.css -o _site/assets/css/main.css --minify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stuup/theaestheticsaccountant.co.uk.git"
  },
  "bugs": {
    "url": "https://github.com/stuup/theaestheticsaccountant.co.uk/issues"
  },
  "homepage": "https://github.com/stuup/theaestheticsaccountant.co.uk#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^6.0.4",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "npm-run-all2": "^9.0.3",
    "tailwindcss": "^4.3.3"
  },
  "private": true,
  "type": "module"
}
